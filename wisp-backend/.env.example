# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

# Banco (Prisma + SQLite). Caminho relativo à raiz do projeto (onde o node
# roda), não à pasta prisma/ — ver prisma.config.ts e src/common/prisma.service.ts.
DATABASE_URL="file:./prisma/dev.db"

# Fila (BullMQ precisa de Redis rodando)
REDIS_URL="redis://localhost:6379"

# Roteiro — plano técnico seção 4.1
ANTHROPIC_API_KEY=""

# Narração — plano técnico seção 4.2 (Narrador e Wisp usam o mesmo provedor,
# voice_id de cada um é fixo pra sempre — ver seção 2.1)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID_NARRADOR=""
ELEVENLABS_VOICE_ID_WISP=""

# Geração de imagem — plano técnico seção 4.3 (a definir provedor final)
IMAGE_GEN_API_KEY=""

# App
PORT=3000
STORAGE_PATH="./storage"
