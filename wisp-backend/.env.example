# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

# Banco (Prisma + SQLite). Caminho relativo à raiz do projeto (onde o node
# roda), não à pasta prisma/ — ver prisma.config.ts e src/common/prisma.service.ts.
DATABASE_URL="file:./prisma/dev.db"

# Fila (BullMQ precisa de Redis rodando)
REDIS_URL="redis://localhost:6379"

# Roteiro — plano técnico seção 4.1
ANTHROPIC_API_KEY=""
# Opcional: usar um gateway (ex: OpenRouter) em vez da Anthropic direta.
# Preencha SÓ UM dos dois pares abaixo, nunca os dois:
#   - Anthropic direta (padrão): preencha ANTHROPIC_API_KEY acima, deixe o
#     resto desta seção em branco.
#   - Gateway tipo OpenRouter: deixe ANTHROPIC_API_KEY em branco, preencha:
ANTHROPIC_BASE_URL=""        # ex: https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=""      # chave do gateway — vai como Bearer, não x-api-key
ANTHROPIC_MODEL=""           # ex: anthropic/claude-sonnet-5 (com prefixo no OpenRouter;
                                            

# Narração — plano técnico seção 4.2 (Narrador e Wisp usam o mesmo provedor,
# voice_id de cada um é fixo pra sempre — ver seção 2.1)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID_NARRADOR=""
ELEVENLABS_VOICE_ID_WISP=""

# Geração de imagem — plano técnico seção 4.3 (a definir provedor final)
IMAGE_GEN_API_KEY=""

# App
PORT=3000
STORAGE_PATH="./storage"
